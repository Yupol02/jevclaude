# Jev provider: "cloudflare" or "typesafe"
JEV_PROVIDER=cloudflare
JEV_MODEL=jev-1.14.0

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# TypeSafe direct
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Test account for your OWN app under test (never a real personal account)
TEST_EMAIL=
TEST_PASSWORD=
